<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Nome de quem fez o comentário -->
    <TextView
        android:id="@+id/tvNomeAutorComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Conteúdo do comentário -->
    <TextView
        android:id="@+id/tvComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_comentarios"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <!-- Data do comentário -->
    <TextView
        android:id="@+id/tvDataComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Botão para editar -->
    <Button
        android:id="@+id/btnEditarComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_editar"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <!-- Botão para excluir -->
    <Button
        android:id="@+id/btnExcluirComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/str_excluir"
        android:visibility="gone"/>

</LinearLayout>
