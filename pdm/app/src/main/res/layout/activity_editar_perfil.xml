<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_editar_perfil"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/sivFotoPerfil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:contentDescription="@string/str_foto_perfil"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSelecionarFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_selecionar_foto_perfil"
                android:layout_marginBottom="24dp"/>

            <!-- Campo de nome: comum aos dois tipos de usuário. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNome"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/str_nome">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tieNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exemplo: João da Silva"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <!-- Campo de e-mail: comum aos dois tipos de usuário. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/str_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tieEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exemplo: joao@email.com"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <!-- Agrupa os campos exclusivos do Profissional. -->
            <LinearLayout
                android:id="@+id/layoutDadosProfissional"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilWhatsapp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/str_whatsapp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tieWhatsapp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="15"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exemplo: (21) 99999-9999"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvAreaAtuacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_area_atuacao"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/cbQuarto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_quarto"
                    android:layout_marginBottom="4dp"/>

                <CheckBox
                    android:id="@+id/cbCozinha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/str_cozinha"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvServicos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Serviços oferecidos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/cbMontagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Montagem de móveis"
                    android:layout_marginBottom="4dp"/>

                <CheckBox
                    android:id="@+id/cbDesmontagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Desmontagem de móveis"
                    android:layout_marginBottom="4dp"/>

                <CheckBox
                    android:id="@+id/cbTransporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transporte de móveis"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDescricao"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descrição profissional">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tieDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minLines="3"
                        android:gravity="top"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exemplo: Trabalho com montagem e desmontagem de móveis e tenho 5 anos de experiência."
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCidade"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/str_cidade">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tieCidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exemplo: Rio de Janeiro"
                    android:textSize="12sp"
                    android:layout_marginBottom="24dp"/>

            </LinearLayout>

            <!-- Botão comum aos dois tipos de usuário. -->
            <Button
                android:id="@+id/btnSalvarAlteracoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_salvar_alteracoes"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>