<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_titulo_principal"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_saudacao_principal"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_perfil"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnBuscarProfissionais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_buscar_profissionais"
                android:layout_marginBottom="16dp"/>

            <!-- Botão para o profissional visualizar os serviços recebidos -->
            <!-- Começa oculto e a sua visibilidade é controlada pela PrincipalActivity -->
            <Button
                android:id="@+id/btnServicosRecebidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_servicos_recebidos"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnComunidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_comunidade"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnLocalizacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/str_localizacao"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>